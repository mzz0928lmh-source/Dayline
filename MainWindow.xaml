<Window x:Class="Dayline.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="日迹 · Dayline" Width="568" Height="660" WindowStyle="None" ResizeMode="NoResize" Background="Transparent" AllowsTransparency="True"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Border x:Name="GlassSurface" Background="#59F0F5F0" BorderThickness="0" CornerRadius="26" Padding="30,22,30,18">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,27">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="26" Height="26" CornerRadius="8" Background="#D9E4D9" Margin="0,0,10,0">
            <Canvas Width="18" Height="18"><Path Data="M 4,5 L 14,5 M 4,9 L 12,9 M 3,14 L 15,12" Stroke="#55755F" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas>
          </Border>
          <TextBlock Text="日迹" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock Text="D A Y L I N E" FontSize="9" Foreground="{StaticResource Muted}" Margin="12,1,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="TodayButton" Content="回到今天" FontSize="11" Click="Today_Click" Visibility="Collapsed" Margin="0,0,4,0"/>
          <Button x:Name="AppearanceButton" Width="34" Height="32" Padding="8" Click="Appearance_Click" ToolTip="外观与交互" AutomationProperties.Name="自定义外观" Margin="0,0,4,0">
            <Path Data="M 3,3 L 14,3 L 11,9 L 6,9 Z M 7,9 L 7,14 C 7,17 10,17 10,14 L 10,9" Stroke="#697A70" StrokeThickness="1.25" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
          <Button x:Name="CalendarButton" Width="34" Height="32" Padding="8" Click="Calendar_Click" ToolTip="日历 · 查看每天的缩略图" AutomationProperties.Name="打开日历">
            <Path Data="M 3,4 L 15,4 L 15,16 L 3,16 Z M 3,8 L 15,8 M 6,2 L 6,6 M 12,2 L 12,6" Stroke="#697A70" StrokeThickness="1.2" StrokeLineJoin="Round"/>
          </Button>
          <Button Width="32" Height="32" Padding="9" Click="Hide_Click" ToolTip="收起 · Esc" AutomationProperties.Name="收起面板" Margin="4,0,0,0">
            <Path Data="M 2,11 L 7,6 L 12,11" Stroke="#697A70" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
        </StackPanel>
      </Grid>

      <Grid x:Name="DayView" Grid.Row="1">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
          <TextBlock x:Name="DateLabel" FontSize="11" Foreground="{StaticResource Muted}" Margin="1,0,0,9"/>
          <Grid>
            <TextBlock x:Name="DayTitle" Text="把今天，慢慢完成。" FontSize="27" FontWeight="Light"/>
            <Border x:Name="HistoryBadge" Visibility="Collapsed" Background="#186B8773" CornerRadius="6" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="8,4"><TextBlock Text="日常回顾" FontSize="10" Foreground="{StaticResource Accent}"/></Border>
          </Grid>
          <TextBlock x:Name="DaySubtitle" Text="写下想做的事，完成后，轻轻划掉。" FontSize="12" Foreground="{StaticResource Muted}" Margin="1,10,0,25"/>
          <Grid Margin="1,0,1,12">
            <TextBlock x:Name="GoalsLabel" Text="今天的目标" FontSize="11" Foreground="{StaticResource Muted}"/>
            <TextBlock x:Name="CountLabel" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource Muted}"/>
          </Grid>
          <Grid Height="2" Margin="0,0,0,12" Background="#12738A78">
            <Border x:Name="ProgressFill" Background="#8BA691" Height="2" HorizontalAlignment="Left" CornerRadius="1"/>
          </Grid>
        </StackPanel>

        <Grid Grid.Row="1">
          <ScrollViewer x:Name="GoalScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Padding="0,0,3,0">
            <StackPanel x:Name="GoalList"/>
          </ScrollViewer>
          <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="0,0,0,18">
            <Canvas Width="70" Height="70" HorizontalAlignment="Center" Margin="0,0,0,16">
              <Ellipse Width="64" Height="64" Canvas.Left="3" Canvas.Top="3" Stroke="#376E8B74" StrokeThickness="1"/>
              <Path Data="M 23,26 L 47,26 M 23,35 L 43,35 M 18,47 C 29,45 42,49 53,42" Stroke="#78917D" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Canvas>
            <TextBlock Text="留一点空白，给今天。" FontSize="15" Foreground="#849187" HorizontalAlignment="Center"/>
            <TextBlock Text="从下面写下第一件小事开始" FontSize="11" Foreground="#99A399" Margin="0,9,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
          <Border BorderBrush="#28768A78" BorderThickness="1" CornerRadius="12" Background="#65FFFFFF" Padding="14,9">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
              <TextBlock Text="+" FontSize="20" Foreground="#879B88" VerticalAlignment="Center" Margin="0,-2,0,0"/>
              <Grid Grid.Column="1">
                <TextBlock x:Name="InputPlaceholder" Text="今天，想完成什么？" Foreground="#8D9B91" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <TextBox x:Name="GoalInput" MaxLength="2000" FontSize="13" VerticalContentAlignment="Center" PreviewKeyDown="Input_KeyDown" TextChanged="Input_TextChanged" AutomationProperties.Name="输入目标，回车添加"/>
              </Grid>
              <Button x:Name="AddButton" Grid.Column="2" Content="↵" FontSize="18" Padding="5,0" Click="Add_Click" ToolTip="添加目标 · Enter" AutomationProperties.Name="添加目标" Foreground="#809584"/>
            </Grid>
          </Border>
          <TextBlock Text="按住文字拖动画线 · 双击编辑 · 右键更多" Foreground="#8E9B92" FontSize="10" HorizontalAlignment="Center" Margin="0,12,0,6"/>
        </StackPanel>
      </Grid>

      <Grid x:Name="CalendarView" Grid.Row="1" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
          <TextBlock Text="每一天，都算数。" FontSize="27" FontWeight="Light"/>
          <TextBlock Text="那些被划掉的小事，都是向前的痕迹。" FontSize="12" Foreground="{StaticResource Muted}" Margin="1,10,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" BorderBrush="#28768A78" BorderThickness="1" CornerRadius="10" Background="#65FFFFFF" Padding="12,1" Margin="0,0,0,12">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
            <Path Data="M 13,7 A 5,5 0 1 1 3,7 A 5,5 0 1 1 13,7 M 12,11 L 17,16" Stroke="#78917D" StrokeThickness="1.4" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <Grid Grid.Column="1">
              <TextBlock x:Name="CalendarSearchPlaceholder" Text="搜索所有日期的任务 · Ctrl+F" FontSize="12" Foreground="#8D9B91" VerticalAlignment="Center" IsHitTestVisible="False"/>
              <TextBox x:Name="CalendarSearchInput" FontSize="12" MaxLength="2000" MinHeight="32" VerticalContentAlignment="Center" TextChanged="CalendarSearch_TextChanged" PreviewKeyDown="CalendarSearch_KeyDown" AutomationProperties.Name="搜索所有日期的任务"/>
            </Grid>
            <Button x:Name="ClearCalendarSearchButton" Grid.Column="2" Content="×" FontSize="18" Padding="5,0" Visibility="Collapsed" Click="ClearCalendarSearch_Click" ToolTip="清空搜索" AutomationProperties.Name="清空任务搜索"/>
          </Grid>
        </Border>
        <Grid x:Name="CalendarMonthHeader" Grid.Row="2" Margin="0,0,0,10">
          <TextBlock x:Name="MonthLabel" FontSize="17" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="‹" Width="30" FontSize="20" Padding="7,2" Click="PreviousMonth_Click" ToolTip="上个月" AutomationProperties.Name="上个月"/>
            <Button Content="本月" FontSize="10" Padding="8,4" Click="ThisMonth_Click"/>
            <Button Content="›" Width="30" FontSize="20" Padding="7,2" Click="NextMonth_Click" ToolTip="下个月" AutomationProperties.Name="下个月"/>
          </StackPanel>
        </Grid>
        <Grid x:Name="CalendarGrid" Grid.Row="3">
          <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <UniformGrid Columns="7">
            <TextBlock Text="一" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="10"/>
            <TextBlock Text="二" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="10"/>
            <TextBlock Text="三" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="10"/>
            <TextBlock Text="四" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="10"/>
            <TextBlock Text="五" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="10"/>
            <TextBlock Text="六" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="10"/>
            <TextBlock Text="日" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="10"/>
          </UniformGrid>
          <UniformGrid x:Name="CalendarCells" Grid.Row="1" Columns="7" Rows="6"/>
        </Grid>
        <Grid x:Name="CalendarSearchView" Grid.Row="3" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock x:Name="CalendarSearchSummary" FontSize="11" Foreground="{StaticResource Muted}" Margin="1,0,0,8"/>
          <ListBox x:Name="CalendarSearchResults" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" PreviewKeyDown="CalendarSearch_KeyDown" MouseDoubleClick="CalendarSearchResults_DoubleClick" SelectionChanged="CalendarSearchResults_SelectionChanged" AutomationProperties.Name="任务搜索结果">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="12,9"/>
                <Setter Property="Margin" Value="0,0,3,6"/>
                <Setter Property="Background" Value="#44FFFFFF"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Template"><Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
                      <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#507E967E"/><Setter Property="BorderBrush" Value="#73937A"/></Trigger>
                      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#347E967E"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value></Setter>
              </Style>
            </ListBox.ItemContainerStyle>
          </ListBox>
          <TextBlock x:Name="CalendarSearchEmpty" Grid.Row="1" Text="没有找到匹配的任务，试试更短的关键词。" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="12"/>
          <DockPanel Grid.Row="2" Margin="0,9,0,0">
            <Button x:Name="LocateCalendarSearchButton" DockPanel.Dock="Right" Content="定位日期 ↵" FontSize="11" Padding="12,7" Background="#2077917E" Click="LocateCalendarSearch_Click" IsEnabled="False" AutomationProperties.Name="定位所选任务的日期"/>
            <TextBlock Text="↑↓ 选择 · Enter / 双击定位" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
          </DockPanel>
        </Grid>
        <TextBlock x:Name="CalendarHint" Grid.Row="4" Text="点击日期，翻开那一天" Foreground="#8E9B92" FontSize="10" HorizontalAlignment="Center" Margin="0,10,0,4"/>
      </Grid>

      <Grid x:Name="AppearanceView" Grid.Row="1" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,24">
          <TextBlock Text="让日迹，更像你。" FontSize="27" FontWeight="Light"/>
          <TextBlock Text="边调整，边感受。每个选择都会自动记住。" FontSize="12" Foreground="{StaticResource Muted}" Margin="1,10,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="1,0,4,0">
            <TextBlock Text="底色" FontSize="12" Margin="0,0,0,10"/>
            <UniformGrid Columns="3" Margin="-3,0,-3,22">
              <Button x:Name="SageTint" Content="鼠尾草" Tag="sage" Click="Tint_Click" Background="#60D8E7D9" Margin="3,0" HorizontalContentAlignment="Center" FontSize="12"/>
              <Button x:Name="WhiteTint" Content="雾白" Tag="white" Click="Tint_Click" Background="#80FFFFFF" Margin="3,0" HorizontalContentAlignment="Center" FontSize="12"/>
              <Button x:Name="SandTint" Content="暖砂" Tag="sand" Click="Tint_Click" Background="#70EEDFC5" Margin="3,0" HorizontalContentAlignment="Center" FontSize="12"/>
            </UniformGrid>
            <Grid><TextBlock Text="背景透明度" FontSize="12"/><TextBlock x:Name="TransparencyLabel" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource Muted}"/></Grid>
            <Slider x:Name="TransparencySlider" Minimum="15" Maximum="85" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="Appearance_ValueChanged" Margin="0,9,0,16" AutomationProperties.Name="背景透明度"/>
            <CheckBox x:Name="BlurToggle" Content="毛玻璃模糊" FontSize="12" Foreground="{StaticResource Ink}" Checked="Appearance_Toggled" Unchecked="Appearance_Toggled" Margin="0,0,0,24"/>
            <Grid><TextBlock Text="圆角" FontSize="12"/><TextBlock x:Name="CornerLabel" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource Muted}"/></Grid>
            <Slider x:Name="CornerSlider" Minimum="12" Maximum="36" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="Appearance_ValueChanged" Margin="0,9,0,22" AutomationProperties.Name="窗口圆角"/>
            <Grid><TextBlock Text="目标字号" FontSize="12"/><TextBlock x:Name="FontLabel" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource Muted}"/></Grid>
            <Slider x:Name="FontSlider" Minimum="13" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Appearance_ValueChanged" Margin="0,9,0,24" AutomationProperties.Name="目标字号"/>
            <Border Height="1" Background="#18738A78" Margin="0,0,0,22"/>
            <Grid><TextBlock Text="顶部唤出等待" FontSize="12"/><TextBlock x:Name="HoverLabel" HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource Muted}"/></Grid>
            <Slider x:Name="HoverSlider" Minimum="0.2" Maximum="2" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="Appearance_ValueChanged" Margin="0,9,0,18" AutomationProperties.Name="顶部悬停秒数"/>
            <CheckBox x:Name="AutoHideToggle" Content="切换到其他窗口时自动收起" FontSize="12" Foreground="{StaticResource Ink}" Checked="Appearance_Toggled" Unchecked="Appearance_Toggled" Margin="0,0,0,18"/>
            <Button x:Name="ResetAppearanceButton" Content="恢复默认外观与交互" Click="ResetAppearance_Click" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Left" Padding="0,8"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Grid Grid.Row="2" Margin="0,18,0,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="SaveDot" Width="4" Height="4" Fill="#89A08C" VerticalAlignment="Center" Margin="0,0,7,0"/>
          <TextBlock x:Name="SaveLabel" Text="已保存在本机" FontSize="10" Foreground="#8E9B92" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="280"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
